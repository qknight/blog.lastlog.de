```nix
# extract-one.nix
{ nixpkgsPath ? /home/nixos/nixpkgs
, attr
, outDir ? ./cargo-locks
}:

let
  pkgs = import nixpkgsPath {
    config.allowUnfree = true;
    config.allowBroken = true;
  };

  original = pkgs.${attr};

  extractor = original.overrideAttrs (old: {
    dontBuild = false;
    doCheck   = false;
    doInstall = false;

    buildPhase = ''
      runHook preBuild

      mkdir -p $out

      echo "=== Cargo.lock extractor for ${attr} ==="

      if [ -f Cargo.lock ]; then
        echo "Found Cargo.lock in $PWD"
        cp -v Cargo.lock $out/Cargo.lock
      elif [ -f "$cargoRoot/Cargo.lock" ]; then
        echo "Found Cargo.lock in cargoRoot"
        cp -v "$cargoRoot/Cargo.lock" $out/Cargo.lock
      else
        echo "ERROR: Cargo.lock not found" >&2
        find . -name 'Cargo.lock' || true
        exit 1
      fi

      echo "Lock file extracted – exiting early"
      exit 0

      runHook postBuild
    '';
  });

in
  extractor
```

```bash
nix-build extract-one.nix --argstr attr aba -o aba
```


in ~/nixpkgs-datamining/extract-one/result-aba

```bash
#!/usr/bin/env sh
set -e

if [ $# -ne 2 ]; then
  echo "Usage: $0 <input-dir> <output-stats-file>" >&2
  exit 1
fi

INPUT_DIR="$1"
OUTPUT_FILE="$2"
LOCK_FILE="${INPUT_DIR%/}/Cargo.lock"

if [ ! -f "$LOCK_FILE" ]; then
  echo "Error: Cargo.lock not found in $INPUT_DIR" >&2
  exit 1
fi

nix-shell -p python3 --run "python3 - <<EOF
import tomllib, hashlib, sys
from pathlib import Path

lock_path = Path(\"$LOCK_FILE\")
out_path  = Path(\"$OUTPUT_FILE\")

if not lock_path.is_file():
    print(f\"Error: {lock_path} does not exist\", file=sys.stderr)
    sys.exit(1)

data = tomllib.loads(lock_path.read_text())

lines = []
for pkg in data.get(\"package\", []):
    name     = pkg[\"name\"]
    version  = pkg[\"version\"]
    checksum = pkg.get(\"checksum\", \"\")
    deps     = sorted(pkg.get(\"dependencies\", []))
    features = sorted(pkg.get(\"features\", pkg.get(\"feature\", [])))

    fingerprint = f\"{checksum}|{deps}|{features}\".encode()
    new_hash = hashlib.sha256(fingerprint).hexdigest()[:16]

    lines.append(f\"{name} {new_hash}\")

out_path.write_text(\"\\n\".join(lines) + \"\\n\")
EOF"
```

