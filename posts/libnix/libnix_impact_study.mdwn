`.trim();

const lines = raw.split('\n');

const releases = lines.map((line, i) => {
  const m = line.match(/^(\S+)\s+([0-9a-f]{40})\s+(\S+)$/i);
  if (!m) return null;
  const [_, ts, commit, path] = m;
  return {
    idx: i + 1,              // line number (y-axis)
    ts,                      // full timestamp
    date: ts.slice(0, 10),   // extract date only (YYYY-MM-DD)
    commit,
    path
  };
}).filter(Boolean);

// Build horizontal segments: from this date to next date at constant y = line number
const x = [];
const y = [];
const hover = [];
for (let i = 0; i < releases.length; i++) {
  const start = releases[i].date;
  const end = (i < releases.length - 1) ? releases[i + 1].date : '2025-12-31';
  const yy = releases[i].idx;

  x.push(start, end, null);
  y.push(yy, yy, null);
  const ht = `#${yy} ${releases[i].commit}<br>${releases[i].path}<br>${releases[i].ts}`;
  hover.push(ht, ht, null);
}

const data = [{
  type: 'scatter',
  mode: 'lines',
  x,
  y,
  text: hover,
  hovertemplate: 'release %{y}<br>%{x}<br>%{text}<extra></extra>',
  line: { width: 4 },
  showlegend: false
}];
var config = {responsive: true}

const layout = {
  title: { text: 'Release timeline (2025)' },
  xaxis: {
    type: 'date',
    range: ['2025-01-01', '2025-12-31'],
    tickformat: '%b',
    dtick: 'M1',
    title: { text: '2025' }
  },
  yaxis: {
    title: { text: 'release' },
    tick0: 0,   // align ticks at 0, 10, 20, ...
    dtick: 10,  // step of 10
    rangemode: 'tozero'
  },
  autosize: true,

  margin: { l: 70, r: 20, t: 60, b: 50 }
};

Plotly.newPlot('myDiv', data, layout, config);

// --- Stats: days in use per release ---
  function toUTCDate(yyyyMmDd) {
    const [Y, M, D] = yyyyMmDd.split('-').map(Number);
    return new Date(Date.UTC(Y, M - 1, D));
  }

  // Difference in calendar days (end exclusive)
  function daysBetween(startStr, endStr) {
    const ms = toUTCDate(endStr) - toUTCDate(startStr);
    return Math.max(0, ms / 86400000);
  }

  const durations = releases.map((r, i) => {
    const end = (i < releases.length - 1) ? releases[i + 1].date : '2025-12-31';
    return { idx: r.idx, days: daysBetween(r.date, end) };
  });

  const vals = durations.map(d => d.days);
  const n = vals.length;
  const sorted = [...vals].sort((a, b) => a - b);
  const mean = vals.reduce((a, b) => a + b, 0) / n;
  function percentile(p) {
    if (!n) return NaN;
    const pos = (n - 1) * p;
    const b = Math.floor(pos), r = pos - b;
    return sorted[b + 1] !== undefined ? sorted[b] + r * (sorted[b + 1] - sorted[b]) : sorted[b];
  }
  const median = percentile(0.5);
  const p25 = percentile(0.25);
  const p75 = percentile(0.75);
  const p90 = percentile(0.90);
  const min = sorted[0];
  const max = sorted[sorted.length - 1];
  const variance = vals.reduce((a, v) => a + Math.pow(v - mean, 2), 0) / (n - 1);
  const stdev = Math.sqrt(variance);
  const releasesPerMonth = n / 12;

  const statsDiv = document.getElementById('stats');
  statsDiv.innerHTML = `
    <b>Usage-days between releases <abbr title="We measure each release’s duration from its date up to (but not including) the next release date; the last runs to 2025‑12‑31.">(end exclusive)</abbr></b><br>
    <abbr title="Total number of releases included">count</abbr>=${n},
    <abbr title="Arithmetic mean of days in use">avg</abbr>=${mean.toFixed(2)}d,
    <abbr title="50th percentile; half the releases are shorter, half longer">median</abbr>=${median.toFixed(1)}d,
    <abbr title="25th percentile (first quartile); 25% are shorter">p25</abbr>=${p25.toFixed(1)}d,
    <abbr title="75th percentile (third quartile); 25% are longer">p75</abbr>=${p75.toFixed(1)}d,
    <abbr title="90th percentile; only 10% lasted longer">p90</abbr>=${p90.toFixed(1)}d,
    <abbr title="Shortest days-in-use gap">min</abbr>=${min.toFixed(0)}d,
    <abbr title="Longest days-in-use gap">max</abbr>=${max.toFixed(0)}d,
    <abbr title="Sample standard deviation; higher means more variable cadence">std</abbr>=${stdev.toFixed(2)}d<br>
    <abbr title="Average number of releases per month in 2025 (count ÷ 12)">cadence</abbr> ≈ ${releasesPerMonth.toFixed(2)} releases/month
  `;
</script>

## nixpkgs architectures

nixpkgs and `buildRustPackage` is used with these 4 different architectures (with different nixpkgs revision than below):

<table class="table table-striped table-bordered">
  <thead class="thead-dark">
    <tr>
      <th>Architecture</th>
      <th>Packages</th>
      <th>% of total</th>
    </tr>
  </thead>
